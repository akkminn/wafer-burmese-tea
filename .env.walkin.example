# Public PromptPay ID (also used by pre-order page; required for walk-in PromptPay QR).
VITE_PROMPTPAY_ID=

# Server-only values for Vercel Functions. Never prefix these with VITE_.
# Comma-separated email:password:role entries (role: admin = can void, staff = record only).
# Example: STAFF_ACCOUNTS="admin@example.com:ChangeMe123:admin,cashier@example.com:Booth2026:staff"
STAFF_ACCOUNTS=
# Optional alternative for a single admin account:
# STAFF_LOGIN_EMAIL=admin@example.com
# STAFF_LOGIN_PASSWORD=ChangeMe123
# Optional dedicated session signing secret (falls back to WALKIN_APPS_SCRIPT_SECRET if omitted):
# STAFF_SESSION_SECRET=

WALKIN_APPS_SCRIPT_URL=
WALKIN_APPS_SCRIPT_SECRET=
