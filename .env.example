# Copy this file to .env.local for local work.
# On Vercel, add these under Project Settings > Environment Variables, then redeploy.

# Public (baked into the browser bundle)
# Unified Google Apps Script web-app URL (apps-script/Code.gs) for pre-orders, slips, walk-in sales, and pickups.
VITE_ORDER_ENDPOINT=
# PromptPay mobile number or 13-digit ID (used for both pre-order and walk-in PromptPay QR codes).
VITE_PROMPTPAY_ID=

# Server-only (for Vercel Functions in /api/staff/* — never prefix these with VITE_)
# Comma-separated email:password:role entries (role: admin = can void, staff = record/pickup only).
# Example: STAFF_ACCOUNTS="admin@example.com:ChangeMe123:admin,cashier@example.com:Booth2026:staff"
STAFF_ACCOUNTS=
# Shared HMAC secret matching WALKIN_SHARED_SECRET in Apps Script Project Settings > Script Properties.
WALKIN_APPS_SCRIPT_SECRET=
# Optional: dedicated secret for signing staff sessions (defaults to WALKIN_APPS_SCRIPT_SECRET if omitted).
# STAFF_SESSION_SECRET=
# Optional: override the Apps Script URL for staff endpoints (defaults to VITE_ORDER_ENDPOINT if omitted).
# WALKIN_APPS_SCRIPT_URL=
