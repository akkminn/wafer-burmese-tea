# Copy this file to .env.local for local work. On Vercel, add the same names under Project Settings > Environment Variables,
# then redeploy (the values are baked in when the site is built).
# Web-app URL of the Google Apps Script (apps-script/README.md). Without it payment slips cannot be uploaded.
VITE_ORDER_ENDPOINT=
# PromptPay mobile number or 13-digit ID that receives the payments. Without it the payment QR is not shown.
VITE_PROMPTPAY_ID=
